{
  "name": "@stardustlc/dsh-dream",
  "version": "0.17.3",
  "description": "DeepSeek Harness 原生任务经验记忆插件。支持任务复盘候选整理、来源与适用范围核对、审阅采纳、AGENTS.md 写入与相关任务召回，内置 5 套浅色/暖色工作台风格（原生清透 / 米白纸感 / Claude 暖书卷 / 8-Bit 像素 / 晴空薄荷）并兼容浅色与柔和深色模式。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs",
    "assets/plugin-icon.webp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "dream",
    "memory",
    "reflection",
    "journal",
    "deepseek",
    "ai-agent",
    "agent-memory",
    "long-term-memory",
    "knowledge-base",
    "记忆",
    "知识库"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dependencies": {
    "@stardustlc/dsh-updates": "0.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "clsx": "2.1.1",
    "postcss": "8.5.6",
    "postcss-modules": "6.0.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-dream.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-dream/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-dream#readme",
  "author": "stardustlc",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp"
}
