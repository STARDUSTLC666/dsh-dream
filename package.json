{
  "name": "@stardustlc/dsh-dream",
  "version": "0.3.2",
  "description": "DSH 做梦插件：agent 在会话间隙回放近期对话（dream_digest）、反思并写入梦境日记（dream_save/journal/recall），高频教训幂等桥接进 AGENTS.md（dream_bridge），六工具含健康自检。多帧 zstd 会话读取，默认隐私脱敏，零运行时依赖。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.8": "unknown",
        "0.1.1-rc.1": "unknown",
        "0.1.1-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "dream",
    "memory",
    "reflection",
    "journal"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-dream.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-dream/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-dream#readme",
  "author": "stardustlc",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.7.0"
}
